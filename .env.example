# Skopiuj do .env (plik jest w .gitignore). Nigdy nie commituj prawdziwych wartości.

# Connection string do bazy XL (tylko odczyt), np.:
# DRIVER={ODBC Driver 18 for SQL Server};SERVER=...;DATABASE=ERPXL_FIRMA;UID=...;PWD=...;ApplicationIntent=ReadOnly;TrustServerCertificate=yes
KSEF_XL_DSN=

# KSeF: NIP kontekstu (musi być równy NIP-owi z firma.toml) i tokeny z Aplikacji Podatnika — osobny na każde środowisko.
# Token pokazuje się tylko raz; nie wysyłać go Slackiem ani mailem.
KSEF_NIP=
KSEF_TOKEN_DEMO=
# KSEF_TOKEN_PROD=
